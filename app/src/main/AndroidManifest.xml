<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 벨소리를 "바로 적용"(시스템 기본 벨소리 설정)하려면 필요한 특별한 권한.
         설치 후 자동으로 허용되지 않고, 설정 화면에서 사용자가 직접 허용해야 한다.
         (Play 프로텍트/백신이 민감 권한으로 경고할 수 있음 → 허용해도 되는 권한) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 통화 중 일시정지는 오디오 포커스로 처리한다.
         (READ_PHONE_STATE 는 민감 권한이라 백신/Play 프로텍트 오탐 우려가 있어 제거)
         Android 9 이하에서만 음악 라이브러리 저장에 필요 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 11+ 패키지 가시성: 벨소리 적용 직후 "갤럭시 사운드 선택기"를
         찾고 여는 데 필요. 없으면 사운드 선택기가 목록에 안 떠서 열 수 없다. -->
    <queries>
        <package android:name="com.samsung.android.app.soundpicker" />
        <intent>
            <action android:name="android.intent.action.RINGTONE_PICKER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.InfinitePlayer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.InfinitePlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 차량/알림에서 "앱 열기" 로 들어올 때 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 사운드 선택기 결과를 받아 실제로 벨소리로 적용하는 투명 창.
             (＋ 목록 화면은 "결과를 호출자에게 돌려주는" 모드라서
              결과를 안 받으면 완료를 눌러도 적용이 안 된다) -->
        <activity
            android:name=".ui.SoundPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.InfinitePlayer.Picker" />

        <!-- 백그라운드 재생 + 차량 블루투스(AVRCP) 제어 -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- 물리 미디어 버튼 / 차량 스티어링휠 버튼 -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
